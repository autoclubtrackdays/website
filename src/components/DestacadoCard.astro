---
import type { CollectionEntry } from 'astro:content';
import {
	cambioTexto,
	kmTexto,
	nombreCorto,
	portada,
	precios,
	precioTexto,
	rutaCoche,
} from '../lib/coches';

interface Props {
	coche: CollectionEntry<'coches'>;
}

const { coche } = Astro.props;
const { data } = coche;

const { contado } = precios(data);
---

<a
	href={rutaCoche(data)}
	class="block overflow-hidden rounded-sm border border-gray-200 bg-white transition hover:border-gray-900"
>
	<img
		src={portada(coche)}
		alt={data.title}
		width="640"
		height="480"
		loading="lazy"
		class="aspect-4/3 w-full object-cover"
	/>

	<div class="p-4">
		<h3 class="text-base font-semibold text-gray-900">{nombreCorto(data)}</h3>
		<!-- Se reserva la linea aunque el coche no tenga version, para que el
		     precio quede a la misma altura en todas las tarjetas de la fila. -->
		<p class="mt-0.5 text-sm text-gray-600 min-h-5">{data.variant}</p>

		<!-- Aquí no se pone guión: es una línea de texto corrido y «— · 7.000 km · —»
		     se lee peor que la lista corta con lo que sí se sabe. -->
		<p class="mt-1 text-sm text-gray-500">
			{
				[
					data.first_registration,
					data.mileage_km != null && kmTexto(data.mileage_km),
					data.fuel,
					cambioTexto(data.transmission),
				]
					.filter(Boolean)
					.join(' · ')
			}
		</p>

		<p class="mt-4 text-lg font-semibold text-gray-900">{precioTexto(contado)}</p>
	</div>
</a>
