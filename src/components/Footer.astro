---
import { CONTACTO } from '../lib/contacto';

const year = new Date().getFullYear();

const ubicacion = CONTACTO.direccion;
const telefono = CONTACTO.telefono;

const redes = [
	{ label: 'Instagram', href: '#' },
	{ label: 'Facebook', href: '#' },
	{ label: 'WhatsApp', href: '#' },
];
---

<footer class="border-t border-gray-200 bg-white">
	<div class="mx-auto max-w-6xl px-6 py-12">
		<div class="flex justify-between gap-8 sm:grid-cols-3">
			<div>
				<p class="text-sm font-semibold text-gray-900">Ubicación</p>
				<p class="mt-3 text-sm text-gray-600">{ubicacion}</p>
			</div>

			<div>
				<p class="text-sm font-semibold text-gray-900">Teléfono</p>
				<p class="mt-3 text-sm text-gray-600">
					<a href={`tel:${telefono.tel}`} class="hover:text-gray-900">{telefono.texto}</a>
				</p>
			</div>

			<div>
				<p class="text-sm font-semibold text-gray-900">Redes sociales</p>
				<ul class="mt-3 space-y-2">
					{
						redes.map((red) => (
							<li>
								<a href={red.href} class="text-sm text-gray-600 hover:text-gray-900">
									{red.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<div class="flex justify-between mt-10 border-t border-gray-200 pt-6">
		    <div>
			    <p class="text-sm text-gray-500">
				    &copy; {year} AutoClub Trackdays. Todos los derechos reservados.
			    </p>
		    </div>
		    <div>
			    <a href="#" class="text-sm text-gray-500 hover:text-gray-900">
			        Privacidad · Términos
			    </a>
		    </div>
		</div>

	</div>
</footer>
