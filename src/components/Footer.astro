---
const year = new Date().getFullYear();

const columns = [
	{
		title: 'Club',
		links: [
			{ label: 'About', href: '/about' },
			{ label: 'Membership', href: '/membership' },
			{ label: 'Events', href: '/events' },
		],
	},
	{
		title: 'Resources',
		links: [
			{ label: 'Gallery', href: '/gallery' },
			{ label: 'News', href: '/news' },
			{ label: 'FAQ', href: '/faq' },
		],
	},
	{
		title: 'Contact',
		links: [
			{ label: 'Email us', href: '/contact' },
			{ label: 'Instagram', href: '#' },
			{ label: 'Facebook', href: '#' },
		],
	},
];
---

<footer class="border-t border-gray-200 bg-white">
	<div class="mx-auto max-w-6xl px-6 py-12">
		<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
			<div>
				<p class="text-lg font-semibold text-gray-900">Auto Club</p>
				<p class="mt-2 text-sm text-gray-600">
					Placeholder description for the club. Replace this text later.
				</p>
			</div>

			{
				columns.map((column) => (
					<div>
						<p class="text-sm font-semibold text-gray-900">{column.title}</p>
						<ul class="mt-3 space-y-2">
							{column.links.map((link) => (
								<li>
									<a href={link.href} class="text-sm text-gray-600 hover:text-gray-900">
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>

		<div class="mt-10 border-t border-gray-200 pt-6">
			<p class="text-sm text-gray-500">&copy; {year} Auto Club. All rights reserved.</p>
		</div>
	</div>
</footer>
