---
import { CONTACTO } from '../lib/contacto';

// Cada servicio es su propia página con su contenido; aquí solo hacen falta los
// enlaces del menú.
const servicios = [
	{ titulo: 'Vendemos tu coche', href: '/vendemos-tu-coche' },
	{ titulo: 'Compramos tu coche', href: '/compramos-tu-coche' },
	{ titulo: 'Pedidos custom', href: '/pedidos-custom' },
];

// En el móvil los servicios salen sueltos, sin el desplegable ni el título:
// meter un submenú dentro de un menú que ya se ha abierto es un paso de más
// para llegar a tres páginas.
const enlacesMovil = [
	{ titulo: 'Catálogo', href: '/catalogo' },
	...servicios,
	{ titulo: 'Contacto', href: '/#contacto' },
];
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-black/90 backdrop-blur">
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-4">
		<!-- El margen negativo cancela el py-4 de la barra solo para el logotipo: la
		     imagen ya trae su propio aire, así que sumarle el de la barra lo dejaba
		     pequeño. Al ocupar todo el alto, además, su fondo deja de recortarse
		     contra el de la barra por arriba y por abajo. -->
		<a href="/" class="block">
			<img
				src="/media/autoclub-3a-lockup.png"
				alt="Autoclub Trackdays"
				width="1280"
				height="480"
				class="-my-4 h-19 w-auto transition hover:scale-105"
			/>
		</a>

		<!-- Hamburguesa: solo en móvil, donde el menú entero no cabe en la barra. -->
		<button
			type="button"
			data-hamburguesa
			aria-controls="menu-movil"
			aria-expanded="false"
			class="-mr-2 grid h-11 w-11 place-items-center text-gray-300 transition hover:text-white md:hidden"
		>
			<span class="sr-only">Abrir el menú</span>
			<svg
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				class="h-6 w-6"
				aria-hidden="true"
			>
				<path data-icono="abrir" d="M4 7h16M4 12h16M4 17h16"></path>
				<path data-icono="cerrar" class="hidden" d="m6 6 12 12M18 6 6 18"></path>
			</svg>
		</button>

		<nav aria-label="Principal" class="hidden md:block">
			<ul class="flex items-baseline gap-8">
				<li>
					<a
						href="/catalogo"
						class="relative text-sm font-medium tracking-wide text-gray-300 uppercase transition after:absolute after:-bottom-1.5 after:left-0 after:h-0.5 after:w-0 after:bg-(--accent) after:transition-all hover:text-white hover:after:w-full"
					>
						Catálogo
					</a>
				</li>

				<li class="relative" data-menu>
					<button
						type="button"
						data-menu-boton
						aria-haspopup="true"
						aria-expanded="false"
						class="relative flex items-center gap-2 text-sm font-medium tracking-wide text-gray-300 uppercase transition after:absolute after:-bottom-1.5 after:left-0 after:h-0.5 after:w-0 after:bg-(--accent) after:transition-all hover:text-white hover:after:w-full"
					>
						Servicios
						<svg
							data-menu-flecha
							viewBox="0 0 20 20"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="h-4 w-4 transition-transform duration-200"
							aria-hidden="true"
						>
							<path d="m5 8 5 5 5-5"></path>
						</svg>
					</button>

					<!-- El panel arranca pegado al botón y el hueco lo hace su propio
					     padding: si fuera un margen, el ratón cruzaría un vacío por el
					     que el menú se cerraría al bajar. -->
					<div data-menu-lista hidden class="absolute top-full left-0 z-40 pt-3">
						<ul class="min-w-64 border border-white/10 bg-black/95 py-1 backdrop-blur">
							{
								servicios.map((servicio) => (
									<li>
										<a
											href={servicio.href}
											class="block border-l-2 border-transparent py-3 pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-gray-300 uppercase transition hover:border-(--accent) hover:bg-white/5 hover:text-white focus-visible:border-(--accent) focus-visible:bg-white/5 focus-visible:text-white focus-visible:outline-none"
										>
											{servicio.titulo}
										</a>
									</li>
								))
							}
						</ul>
					</div>
				</li>

				<li>
					<a
						href="/#contacto"
						class="relative text-sm font-medium tracking-wide text-gray-300 uppercase transition after:absolute after:-bottom-1.5 after:left-0 after:h-0.5 after:w-0 after:bg-(--accent) after:transition-all hover:text-white hover:after:w-full"
					>
						Contacto
					</a>
				</li>

				<li class="hidden sm:block">
					<a
						href={`tel:${CONTACTO.telefono.tel}`}
						class="rounded-sm bg-(--accent) px-4 py-2 text-sm font-semibold text-black transition hover:bg-(--accent-strong)"
					>
						{CONTACTO.telefono.texto}
					</a>
				</li>
			</ul>
		</nav>
	</div>

	<div id="menu-movil" hidden class="border-t border-white/10 bg-black/95 md:hidden">
		<ul class="mx-auto flex max-w-6xl flex-col px-6 pb-6">
			{
				enlacesMovil.map((enlace) => (
					<li class="border-b border-white/10">
						<a
							href={enlace.href}
							class="block py-4 text-base font-medium tracking-wide text-gray-300 uppercase transition hover:text-white"
						>
							{enlace.titulo}
						</a>
					</li>
				))
			}

			<li class="pt-6">
				<a
					href={`tel:${CONTACTO.telefono.tel}`}
					class="block rounded-sm bg-(--accent) px-4 py-4 text-center text-base font-semibold text-black"
				>
					Llamar {CONTACTO.telefono.texto}
				</a>
			</li>
		</ul>
	</div>
</header>

<script>
	// Menú de móvil.
	const hamburguesa = document.querySelector<HTMLButtonElement>('[data-hamburguesa]');
	const menuMovil = document.getElementById('menu-movil');

	if (hamburguesa && menuMovil) {
		const abrirMovil = (mostrar: boolean) => {
			menuMovil.hidden = !mostrar;
			hamburguesa.setAttribute('aria-expanded', String(mostrar));

			hamburguesa
				.querySelectorAll<SVGElement>('[data-icono]')
				.forEach((icono) =>
					icono.classList.toggle('hidden', icono.dataset.icono !== (mostrar ? 'cerrar' : 'abrir')),
				);
		};

		hamburguesa.addEventListener('click', () => abrirMovil(menuMovil.hidden !== false));

		// Al pulsar un enlace se cierra: si no, el menú tapa la página a la que
		// acabas de saltar, y con #contacto ni siquiera cambia de página.
		menuMovil.addEventListener('click', (evento) => {
			if ((evento.target as HTMLElement).closest('a')) abrirMovil(false);
		});

		document.addEventListener('keydown', (evento) => {
			if (evento.key === 'Escape') abrirMovil(false);
		});

		// Si se gira el móvil o se ensancha la ventana, el menú deja de verse pero
		// seguiría abierto por debajo, y reaparecería al volver a estrechar.
		window
			.matchMedia('(min-width: 768px)')
			.addEventListener('change', (evento) => evento.matches && abrirMovil(false));
	}

	// Menú de servicios. Se abre al pasar por encima, y también con clic: en
	// pantalla táctil no hay hover que valga.
	const menu = document.querySelector<HTMLElement>('[data-menu]');
	const boton = menu?.querySelector<HTMLButtonElement>('[data-menu-boton]');
	const lista = menu?.querySelector<HTMLElement>('[data-menu-lista]');
	const flecha = menu?.querySelector<SVGElement>('[data-menu-flecha]');

	if (menu && boton && lista) {
		const enlaces = [...lista.querySelectorAll<HTMLAnchorElement>('a')];

		// El estado va aparte y no se lee de `lista.hidden`, que además de ser
		// `boolean | string` (por `hidden="until-found"`) obliga a convertirlo.
		let abierto = false;

		const abrir = (mostrar: boolean) => {
			abierto = mostrar;
			lista.hidden = !mostrar;
			boton.setAttribute('aria-expanded', String(mostrar));
			flecha?.classList.toggle('rotate-180', mostrar);
		};

		// Se abre al pasar por encima. El pequeño retardo al salir perdona el
		// movimiento en diagonal hacia el panel.
		let cierre: number | undefined;

		const cancelarCierre = () => window.clearTimeout(cierre);

		menu.addEventListener('mouseenter', () => {
			cancelarCierre();
			abrir(true);
		});

		menu.addEventListener('mouseleave', () => {
			cancelarCierre();
			cierre = window.setTimeout(() => abrir(false), 150);
		});

		boton.addEventListener('click', () => abrir(!abierto));

		document.addEventListener('click', (evento) => {
			if (!menu.contains(evento.target as Node)) abrir(false);
		});

		menu.addEventListener('keydown', (evento) => {
			if (evento.key === 'Escape') {
				abrir(false);
				boton.focus();
				return;
			}

			if (evento.key !== 'ArrowDown' && evento.key !== 'ArrowUp') return;
			evento.preventDefault();

			if (!abierto) {
				abrir(true);
				enlaces[0]?.focus();
				return;
			}

			const actual = enlaces.indexOf(document.activeElement as HTMLAnchorElement);
			const salto = evento.key === 'ArrowDown' ? 1 : -1;
			enlaces[Math.min(Math.max(actual + salto, 0), enlaces.length - 1)]?.focus();
		});
	}
</script>
