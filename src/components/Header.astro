---
const navLinks = [
	{ label: 'Catálogo', href: '/catalogo' },
	{ label: 'Contacto', href: '#contacto' },
];
---

<header class="border-b border-gray-200 bg-white">
	<div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
		<a href="/" class="flex items-center gap-3 text-lg font-semibold text-black">
			<img src="/logo.svg" alt="Logo de AutoClub Trackdays" width="32" height="32" class="h-8 w-8" />
			<span>Autoclub Trackdays</span>
		</a>

		<nav aria-label="Principal">
			<ul class="flex items-center gap-6">
				{
					navLinks.map((link) => (
						<li>
							<a href={link.href} class="text-gray-600 hover:text-gray-900 uppercase">
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>
