---
import type { CollectionEntry } from 'astro:content';
import {
	cambioTexto,
	GUION,
	kmTexto,
	nombreCorto,
	portada,
	potenciaTexto,
	precios,
	precioTexto,
	rutaCoche,
} from '../lib/coches';

interface Props {
	coche: CollectionEntry<'coches'>;
}

const { coche } = Astro.props;
const { data } = coche;

const { contado, financiado } = precios(data);

// Una fila por pareja: el primer dato va a la izquierda y el segundo a la derecha.
// Lo que el coche no declare sale con guión: la rejilla es fija, y dejar el hueco
// vacío descuadraba la tarjeta contra las de al lado.
const especificaciones = [
	[kmTexto(data.mileage_km), data.first_registration ?? GUION],
	[potenciaTexto(data) ?? GUION, cambioTexto(data.transmission) ?? GUION],
	[data.body_type ?? GUION, data.fuel ?? GUION],
];
---

<a
	href={rutaCoche(data)}
	class="flex flex-col overflow-hidden border border-gray-200 bg-white transition hover:border-gray-900"
>
	<img
		src={portada(coche)}
		alt={data.title}
		width="640"
		height="480"
		loading="lazy"
		class="aspect-4/3 w-full object-cover"
	/>

	<div class="flex flex-1 flex-col p-5">
		<h3 class="text-xl font-semibold text-gray-900">{nombreCorto(data)}</h3>
		<!-- Se reserva la linea aunque el coche no tenga version, para que el
		     precio quede a la misma altura en todas las tarjetas de la fila. -->
		<p class="mt-0.5 text-lg text-gray-600 min-h-7">{data.variant}</p>

		<div class="mt-5 flex flex-wrap items-end justify-between gap-x-8 gap-y-2">
			<div>
				<p class="text-base tracking-wide text-gray-500 uppercase">Al contado</p>
				<p class="text-4xl font-bold text-gray-900">{precioTexto(contado)}</p>
			</div>

			{
				financiado && (
					<div class="text-right">
						<p class="text-base tracking-wide text-gray-500 uppercase">Financiado</p>
						<p class="text-2xl font-semibold text-emerald-800">{precioTexto(financiado)}</p>
					</div>
				)
			}
		</div>

		<ul
			class="mt-auto flex flex-col gap-y-2 border-t border-gray-200 pt-5 text-lg text-gray-600"
		>
			{
				especificaciones.map(([izquierda, derecha]) => (
					<li class="flex justify-between gap-4">
						<span>{izquierda}</span>
						<span>{derecha}</span>
					</li>
				))
			}
		</ul>
	</div>
</a>
