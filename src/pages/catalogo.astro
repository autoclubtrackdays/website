---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CatalogoCard from '../components/CatalogoCard.astro';

const coches = (await getCollection('coches')).sort(
	(a, b) => a.data.precioContado - b.data.precioContado,
);
---

<Layout title="Catálogo — AutoClub Trackdays">
	<section class="mx-auto max-w-6xl px-6 py-16">
		<h1 class="text-3xl font-semibold tracking-tight text-gray-900">Catálogo</h1>
		<p class="mt-2 text-sm text-gray-500">
			{coches.length}
			{coches.length === 1 ? ' unidad disponible' : ' unidades disponibles'}
		</p>

		<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{coches.map((coche) => <CatalogoCard coche={coche} />)}
		</div>
	</section>
</Layout>
