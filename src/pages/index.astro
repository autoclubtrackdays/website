---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import DestacadoCard from '../components/DestacadoCard.astro';
import { DESTACADOS } from '../lib/destacados';
import { CONTACTO, MAPA_EMBED, WHATSAPP_ENLACE } from '../lib/contacto';

const coches = await getCollection('coches');

const destacados = DESTACADOS.map((id) => {
	const coche = coches.find((candidato) => candidato.id === id);
	if (!coche) throw new Error(`Destacado sin coche: no existe la carpeta src/content/coches/${id}`);
	return coche;
});

// Las marcas salen del propio stock, sin lista escrita a mano.
const marcas = [...new Set(coches.map((coche) => coche.data.make))].sort();

const titulo = 'Autoclub Trackdays | Compraventa de coches en Madrid';
const descripcion =
	'Compraventa de coches en Madrid desde hace más de 25 años. Deportivos, clásicos y utilitarios revisados, con garantía y financiación. Isla de Sumatra Nº 36, 28034 Madrid. Tel. 649 96 31 31.';

/**
 * Ficha del negocio para Google, en el formato que entiende: de aquí salen el
 * horario, el teléfono y la dirección que aparecen en el resultado de búsqueda
 * y en Maps, sin que Google tenga que adivinarlos leyendo la página.
 *
 * Solo se declara lo que es cierto y comprobable. En cuanto haya perfil de
 * Instagram, su dirección va en `sameAs`: es como Google ata la web al perfil.
 */
const negocio = {
	'@context': 'https://schema.org',
	'@type': 'AutoDealer',
	'@id': new URL('#negocio', Astro.site).href,
	name: 'Autoclub Trackdays',
	description: descripcion,
	url: Astro.site?.href,
	logo: new URL('/media/autoclub-3a-favicon-512.png', Astro.site).href,
	image: new URL('/media/og.jpg', Astro.site).href,
	telephone: CONTACTO.telefono.tel,
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	address: {
		'@type': 'PostalAddress',
		streetAddress: 'Isla de Sumatra Nº 36',
		postalCode: '28034',
		addressLocality: 'Madrid',
		addressRegion: 'Madrid',
		addressCountry: 'ES',
	},
	areaServed: { '@type': 'AdministrativeArea', name: 'Comunidad de Madrid' },
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '08:00',
			closes: '21:00',
		},
	],
	// Las marcas salen del stock real, así que la lista se actualiza sola.
	brand: marcas.map((marca) => ({ '@type': 'Brand', name: marca })),
};
---

<Layout title={titulo} description={descripcion}>
	<!-- La foto del hero es lo más grande que se descarga y es el fondo de un
	     div, así que el navegador no la ve hasta tener el CSS. Con el preload
	     empieza a bajarla a la vez que la hoja de estilos. -->
	<Fragment slot="cabeza">
		<link rel="preload" as="image" href="/media/hero-1024.webp" media="(max-width: 767px)" />
		<link rel="preload" as="image" href="/media/hero.webp" media="(min-width: 768px)" />
		<script type="application/ld+json" set:html={JSON.stringify(negocio)} is:inline />
	</Fragment>

	<section class="relative flex min-h-140 items-end overflow-hidden bg-black lg:aspect-12/5 lg:min-h-0">
		<div class="hero-foto acercar absolute inset-0 bg-gray-900 bg-cover bg-center"></div>

		<!-- Degradado en lugar de velo plano: la foto se ve arriba y el texto
		     apoya sobre negro abajo, que es donde tiene que leerse. -->
		<div class="absolute inset-0 bg-linear-to-t from-black via-black/60 to-black/10"></div>

		<div
			class="relative mx-auto grid w-full max-w-6xl grid-cols-1 items-end gap-x-8 gap-y-10 px-6 py-16 lg:grid-cols-[1fr_auto]"
		>
			<div>
				<span class="entra block h-1 w-14 bg-(--accent)"></span>

				<h1
					class="entra mt-8 text-5xl font-semibold tracking-tighter text-white sm:text-7xl"
					style="animation-delay: 0.1s"
				>
					Autoclub Trackdays
				</h1>

				<p class="entra mt-6 max-w-xl text-2xl text-gray-200" style="animation-delay: 0.2s">
					Dedicándonos a la compraventa desde hace más de 25 años.
				</p>
			</div>

			<div
				class="entra flex flex-wrap items-center justify-center gap-4 self-center"
				style="animation-delay: 0.35s"
			>
				<a
					href="/catalogo"
					class="rounded-sm bg-(--accent) px-8 py-4 text-2xl font-semibold text-black shadow-lg shadow-black/30 transition hover:-translate-y-1 hover:bg-(--accent-strong)"
				>
					Ver catálogo
				</a>
			</div>
		</div>
	</section>

	<!-- Cifras: las dos primeras salen de datos reales, no de un adjetivo. -->
	<section class="border-b border-gray-200 bg-black">
		<div class="mx-auto grid max-w-6xl grid-cols-1 divide-y divide-white/10 text-center sm:grid-cols-3 sm:divide-x sm:divide-y-0 sm:text-left">
			<div class="px-6 py-8">
				<p class="text-4xl font-semibold tracking-tight text-(--accent)">+25</p>
				<p class="mt-1 text-sm tracking-wide text-gray-400 uppercase">años en el sector</p>
			</div>
			<div class="px-6 py-8">
				<p class="text-4xl font-semibold tracking-tight text-(--accent)">+500</p>
				<p class="mt-1 text-sm tracking-wide text-gray-400 uppercase">coches vendidos</p>
			</div>
			<div class="px-6 py-8">
				<p class="text-4xl font-semibold tracking-tight text-(--accent)">Madrid</p>
				<p class="mt-1 text-sm tracking-wide text-gray-400 uppercase">{CONTACTO.direccion}</p>
			</div>
		</div>
	</section>

	<!-- Cinta de marcas: lista duplicada para que el bucle no de tiron. -->
	<section class="overflow-hidden border-b border-gray-200 py-6">
		<div class="desfila flex w-max items-center gap-12 pr-12">
			{
				[...marcas, ...marcas].map((marca) => (
					<span class="flex items-center gap-12 text-2xl font-semibold tracking-tight whitespace-nowrap text-gray-400">
						{marca}
						<span class="h-1.5 w-1.5 rounded-full bg-(--accent)" />
					</span>
				))
			}
		</div>
	</section>

	<section class="mx-auto max-w-7xl px-6 pt-24">
		<div data-revelar class="flex flex-wrap items-baseline justify-between gap-4">
			<h2 class="text-4xl font-semibold tracking-tight text-gray-900 uppercase sm:text-5xl">
				Destacados
			</h2>
			<a
				href="/catalogo"
				class="inline-flex items-center gap-2 border-b-2 border-(--accent) pb-1 text-base font-semibold tracking-wide text-black uppercase transition hover:translate-x-3"
			>
				Catálogo
				<svg
					viewBox="0 0 20 20"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="h-4 w-4"
					aria-hidden="true"
				>
					<path d="M4 10h12m0 0-4-4m4 4-4 4" />
				</svg>
			</a>
		</div>

		<span data-revelar class="mt-3 block h-1 w-16 bg-(--accent)"></span>

		<div data-revelar class="relative mx-auto mt-10 w-full sm:w-[90%]">
			<ul
				id="carrusel-destacados"
				class="flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth [-ms-overflow-style:none] scrollbar-none [&::-webkit-scrollbar]:hidden"
			>
				{
					destacados.map((coche) => (
						<li class="w-72 shrink-0 snap-start sm:w-80">
							<DestacadoCard coche={coche} />
						</li>
					))
				}
			</ul>

			<!-- Aviso de que hay más a la derecha, ahora que no hay barra de scroll.
			     El script lo apaga al llegar al final. -->
			<!-- En el móvil no se pinta: allí no hay flechas, y tapar la tarjeta
			     siguiente con un degradado blanco esconde justo lo que hace ver que
			     la lista sigue. Sin él, la siguiente asoma cortada por el borde. -->
			<div
				data-carrusel="fundido"
				class="pointer-events-none absolute inset-y-0 right-0 hidden w-20 bg-linear-to-l from-white to-transparent transition-opacity duration-300 sm:block"
			>
			</div>

			<button
				type="button"
				data-carrusel="anterior"
				aria-label="Coches anteriores"
				class="absolute top-28 -left-4 hidden h-12 w-12 place-items-center rounded-full border border-gray-200 bg-white text-black shadow-lg transition hover:scale-110 hover:border-(--accent) hover:bg-(--accent) disabled:pointer-events-none disabled:opacity-0 sm:grid"
			>
				<svg
					viewBox="0 0 20 20"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="h-4 w-4"
					aria-hidden="true"
				>
					<path d="M12 4 6 10l6 6" />
				</svg>
			</button>

			<button
				type="button"
				data-carrusel="siguiente"
				aria-label="Coches siguientes"
				class="absolute top-28 -right-4 hidden h-12 w-12 place-items-center rounded-full border border-gray-200 bg-white text-black shadow-lg transition hover:scale-110 hover:border-(--accent) hover:bg-(--accent) disabled:pointer-events-none disabled:opacity-0 sm:grid"
			>
				<svg
					viewBox="0 0 20 20"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="h-4 w-4"
					aria-hidden="true"
				>
					<path d="m8 4 6 6-6 6" />
				</svg>
			</button>
		</div>
	</section>

	<section id="contacto" class="bg-white">
		<div class="mx-auto max-w-7xl px-6 py-24">
			<h2 data-revelar class="text-4xl font-semibold tracking-tight text-gray-900 uppercase sm:text-5xl">
				Contacto
			</h2>
			<span data-revelar class="mt-3 block h-1 w-16 bg-(--accent)"></span>

			<div class="mx-auto mt-14 w-[95%] grid gap-14 lg:grid-cols-2">
				<div data-revelar class="flex flex-col gap-10">
					<div>
						<p class="text-sm text-gray-500 uppercase">Llámanos</p>
						<a
							href={`tel:${CONTACTO.telefono.tel}`}
							class="mt-2 inline-block text-5xl font-semibold tracking-tighter text-gray-900 decoration-(--accent) decoration-4 underline-offset-8 transition hover:underline sm:text-6xl"
						>
							{CONTACTO.telefono.texto}
						</a>
						<p class="mt-4 max-w-md text-gray-600">
							Te atendemos en el momento. Si prefieres escribir, por WhatsApp.
						</p>

						<div class="mt-8 flex flex-wrap gap-4">
							<a
								href={WHATSAPP_ENLACE}
								target="_blank"
								rel="noopener"
								class="rounded-sm bg-(--accent) px-6 py-3 font-semibold text-black transition hover:-translate-y-1 hover:bg-(--accent-strong)"
							>
								Escribir por WhatsApp
							</a>
						</div>
					</div>

					<div class="grid gap-8 border-t border-gray-200 pt-10 sm:grid-cols-2">
						<div>
							<p class="text-sm tracking-wide text-gray-500 uppercase">Dónde estamos</p>
							<p class="mt-3 text-gray-900">{CONTACTO.direccion}</p>
						</div>

						<div>
							<p class="text-sm tracking-wide text-gray-500 uppercase">Horario</p>
							<p class="mt-3 text-gray-900">{CONTACTO.horario}</p>
						</div>
					</div>
				</div>

				<div data-revelar class="overflow-hidden rounded-sm border border-gray-200">
					<iframe
						src={MAPA_EMBED}
						title={`Mapa de ${CONTACTO.direccion}`}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						class="aspect-4/3 w-full lg:aspect-auto lg:h-full"></iframe>
				</div>
			</div>
		</div>
	</section>
</Layout>

<script>
	const pista = document.getElementById('carrusel-destacados');
	const anterior = document.querySelector('[data-carrusel="anterior"]');
	const siguiente = document.querySelector('[data-carrusel="siguiente"]');
	const fundido = document.querySelector('[data-carrusel="fundido"]');

	if (
		pista instanceof HTMLElement &&
		anterior instanceof HTMLButtonElement &&
		siguiente instanceof HTMLButtonElement
	) {
		// Una card mas el gap-6 (24px): el salto siempre deja otra card alineada.
		const paso = () => {
			const card = pista.firstElementChild;
			return card ? card.getBoundingClientRect().width + 24 : pista.clientWidth;
		};

		anterior.addEventListener('click', () => pista.scrollBy({ left: -paso(), behavior: 'smooth' }));
		siguiente.addEventListener('click', () => pista.scrollBy({ left: paso(), behavior: 'smooth' }));

		// Se ocultan al llegar a cada extremo. El margen de 1px evita que el
		// redondeo a subpixeles deje el boton activo sin recorrido posible.
		const actualizar = () => {
			const alFinal = pista.scrollLeft + pista.clientWidth >= pista.scrollWidth - 1;

			anterior.disabled = pista.scrollLeft <= 1;
			siguiente.disabled = alFinal;

			// El degradado solo tiene sentido mientras quede algo por ver.
			fundido?.classList.toggle('opacity-0', alFinal);
		};

		pista.addEventListener('scroll', actualizar, { passive: true });
		window.addEventListener('resize', actualizar);
		actualizar();
	}
</script>

<script>
	// Aparicion al entrar en pantalla. Se observa una sola vez por elemento.
	const revelables = document.querySelectorAll('[data-revelar]');

	if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		revelables.forEach((elemento) => elemento.classList.add('visible'));
	} else {
		const observador = new IntersectionObserver(
			(entradas) => {
				entradas.forEach((entrada) => {
					if (!entrada.isIntersecting) return;
					entrada.target.classList.add('visible');
					observador.unobserve(entrada.target);
				});
			},
			{ threshold: 0.15, rootMargin: '0px 0px -60px 0px' },
		);

		revelables.forEach((elemento) => observador.observe(elemento));
	}
</script>
