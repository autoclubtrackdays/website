---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import DestacadoCard from '../components/DestacadoCard.astro';
import { DESTACADOS } from '../lib/destacados';
import { CONTACTO, MAPA_EMBED, MAPA_ENLACE } from '../lib/contacto';

const ubicacion = 'Isla de Sumatra Nº 36, 28034 Madrid';

const coches = await getCollection('coches');

const destacados = DESTACADOS.map((id) => {
	const coche = coches.find((candidato) => candidato.id === id);
	if (!coche) throw new Error(`Destacado sin coche: no existe src/content/coches/${id}.md`);
	return coche;
});
---

<Layout title="AutoClub Trackdays">
	<!-- Foto de ejemplo (Unsplash, 1920x800). Sustituir por una propia. -->
	<section
		class="relative flex min-h-105 items-end bg-gray-800 bg-cover bg-center lg:aspect-12/5 lg:min-h-0"
		style="background-image: url('/hero.jpg')"
	>
		<div class="absolute inset-0 bg-black/25"></div>

		<div
			class="relative grid grid-cols-2 mx-auto w-full max-w-6xl items-end justify-between gap-x-8 gap-y-8 px-6 py-16"
		>
			<div>
				<span class="block h-px w-10 bg-(--accent)"></span>

				<h1 class="mt-6 text-4xl font-semibold tracking-tight text-white sm:text-5xl">
					Autoclub Trackdays
				</h1>

				<p class="mt-4 text-xl text-gray-100">
					Dedicándonos a la compraventa desde hace más de 25 años.
				</p>
				<p class="mt-4 text-lg text-gray-300">{ubicacion}</p>
			</div>

		    <div class="flex flex-wrap items-center justify-center gap-4">
			    <a
				    href="/catalogo"
				    class="rounded-sm bg-(--accent) px-8 py-4 text-2xl font-semibold text-gray-900 transition hover:bg-(--accent-strong)"
				>
				    Ver catálogo
			    </a>
			    <a
				    href="#contacto"
				    class="text-center rounded-lg border border-white/70 px-8 py-4 text-lg font-semibold text-white transition hover:bg-white hover:text-gray-900"
				>
				    Contactar
				</a>
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-20">
		<div class="flex items-baseline justify-between gap-4">
			<h2 class="text-4xl font-semibold tracking-tight text-gray-900 uppercase">Coches destacados</h2>
			<a
				href="/catalogo"
				class="inline-flex items-center gap-2 border-b-2 border-(--accent) pb-1 text-base font-semibold tracking-wide text-black uppercase transition hover:translate-x-3"
			>
				Catálogo
				<svg
					viewBox="0 0 20 20"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="h-4 w-4"
					aria-hidden="true"
				>
					<path d="M4 10h12m0 0-4-4m4 4-4 4" />
				</svg>
			</a>
		</div>

		<div class="relative mt-10">
			<ul
				id="carrusel-destacados"
				class="flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth [-ms-overflow-style:none] scrollbar-none [&::-webkit-scrollbar]:hidden"
			>
				{
					destacados.map((coche) => (
						<li class="w-72 shrink-0 snap-start sm:w-80">
							<DestacadoCard coche={coche} />
						</li>
					))
				}
			</ul>

			<button
				type="button"
				data-carrusel="anterior"
				aria-label="Coches anteriores"
				class="absolute top-28 -left-4 hidden h-10 w-10 place-items-center rounded-full border border-gray-400 bg-white text-gray-900 shadow-sm transition hover:border-gray-400 disabled:pointer-events-none disabled:opacity-0 sm:grid"
			>
				<svg
					viewBox="0 0 20 20"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="h-4 w-4"
					aria-hidden="true"
				>
					<path d="M12 4 6 10l6 6" />
				</svg>
			</button>

			<button
				type="button"
				data-carrusel="siguiente"
				aria-label="Coches siguientes"
				class="absolute top-28 -right-4 hidden h-10 w-10 place-items-center rounded-full border border-gray-400 bg-white text-gray-900 shadow-sm transition hover:border-gray-400 disabled:pointer-events-none disabled:opacity-0 sm:grid"
			>
				<svg
					viewBox="0 0 20 20"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="h-4 w-4"
					aria-hidden="true"
				>
					<path d="m8 4 6 6-6 6" />
				</svg>
			</button>
		</div>
	</section>

	<section id="contacto" class="border-t border-gray-200">
		<div class="mx-auto max-w-6xl px-6 py-20">
			<h2 class="text-4xl font-semibold tracking-tight text-gray-900 uppercase">Contacto</h2>
			<span class="mt-3 block h-1 w-100 bg-(--accent)"></span>

			<div class="mt-12 grid gap-12 lg:grid-cols-2">
				<div class="flex flex-col gap-10">
					<div>
						<p class="text-sm tracking-wide text-gray-500 uppercase">Llámanos</p>
						<a
							href={`tel:${CONTACTO.telefono.tel}`}
							class="mt-2 inline-block text-4xl font-semibold tracking-tight text-gray-900 decoration-(--accent) decoration-4 underline-offset-8 hover:underline sm:text-5xl"
						>
							{CONTACTO.telefono.texto}
						</a>
						<p class="mt-3 text-gray-600">
							Te atendemos en el mismo momento. Si prefieres escribir, por WhatsApp o correo.
						</p>

						<div class="mt-6 flex flex-wrap gap-4">
							<a
								href={`https://wa.me/${CONTACTO.whatsapp.numero}`}
								target="_blank"
								rel="noopener"
								class="rounded-sm bg-(--accent) px-6 py-3 font-semibold text-gray-900 transition hover:bg-(--accent-strong)"
							>
								Escribir por WhatsApp
							</a>
							<a
								href={`mailto:${CONTACTO.email}`}
								class="rounded-sm border border-gray-300 px-6 py-3 font-semibold text-gray-900 transition hover:border-gray-900"
							>
								{CONTACTO.email}
							</a>
						</div>
					</div>

					<div class="grid gap-8 sm:grid-cols-2">
						<div>
							<p class="text-sm tracking-wide text-gray-500 uppercase">Dónde estamos</p>
							<p class="mt-3 text-gray-900">{CONTACTO.direccion}</p>
						</div>

						<div>
							<p class="text-sm tracking-wide text-gray-500 uppercase">Horario</p>
							<p class="mt-3 text-gray-900">Todos los dias de 8:00 a 21:00</p>
						</div>
					</div>
				</div>

				<div class="overflow-hidden rounded-sm border border-gray-200">
					<iframe
						src={MAPA_EMBED}
						title={`Mapa de ${CONTACTO.direccion}`}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						class="aspect-4/3 w-full lg:h-full lg:aspect-auto"
					></iframe>
				</div>
			</div>
		</div>
	</section>
</Layout>

<script>
	const pista = document.getElementById('carrusel-destacados');
	const anterior = document.querySelector('[data-carrusel="anterior"]');
	const siguiente = document.querySelector('[data-carrusel="siguiente"]');

	if (pista instanceof HTMLElement && anterior instanceof HTMLButtonElement && siguiente instanceof HTMLButtonElement) {
		// Una card mas el gap-6 (24px): el salto siempre deja otra card alineada.
		const paso = () => {
			const card = pista.firstElementChild;
			return card ? card.getBoundingClientRect().width + 24 : pista.clientWidth;
		};

		anterior.addEventListener('click', () => pista.scrollBy({ left: -paso(), behavior: 'smooth' }));
		siguiente.addEventListener('click', () => pista.scrollBy({ left: paso(), behavior: 'smooth' }));

		// Se ocultan al llegar a cada extremo. El margen de 1px evita que el
		// redondeo a subpixeles deje el boton activo sin recorrido posible.
		const actualizar = () => {
			anterior.disabled = pista.scrollLeft <= 1;
			siguiente.disabled = pista.scrollLeft + pista.clientWidth >= pista.scrollWidth - 1;
		};

		pista.addEventListener('scroll', actualizar, { passive: true });
		window.addEventListener('resize', actualizar);
		actualizar();
	}
</script>
