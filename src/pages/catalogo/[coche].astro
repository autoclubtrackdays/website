---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { CONTACTO } from '../../lib/contacto';
import {
	cambioTexto,
	fotos,
	kmTexto,
	nombreCorto,
	GUION,
	nombreCompleto,
	rutaCoche,
	potenciaTexto,
	precios,
	precioTexto,
	slugCoche,
} from '../../lib/coches';

export async function getStaticPaths() {
	const enStock = await getCollection('coches');
	const vendidos = await getCollection('vendidos');

	const todos = [
		...enStock.map((coche) => ({ coche, vendido: false })),
		...vendidos.map((coche) => ({ coche, vendido: true })),
	];

	// Con la referencia dentro del slug no debería colisionar nunca, pero si el
	// origen repitiera una referencia se verían dos coches en la misma URL.
	const vistos = new Set<string>();

	return todos.map(({ coche, vendido }) => {
		const slug = slugCoche(coche.data);
		if (vistos.has(slug)) throw new Error(`Dos coches comparten la URL /catalogo/${slug}`);
		vistos.add(slug);

		return { params: { coche: slug }, props: { coche, vendido } };
	});
}

interface Props {
	coche: CollectionEntry<'coches'>;
	vendido: boolean;
}

const { coche, vendido } = Astro.props;
const { data } = coche;

const galeria = fotos(coche);
const { contado, financiado } = precios(data);
const nombre = nombreCorto(data);

// Resumen de cabecera: lo que se mira antes de bajar a la ficha completa.
// Son seis casillas fijas: lo que el coche no declare sale con guión, en vez de
// desaparecer y dejar la rejilla coja. La ficha larga de más abajo sí esconde lo
// que falta, porque allí serían diecisiete guiones seguidos.
const resumen = [
	{ campo: 'Kilometraje', valor: kmTexto(data.mileage_km) },
	{ campo: 'Fecha', valor: data.first_registration ?? GUION },
	{ campo: 'Potencia', valor: potenciaTexto(data) ?? GUION },
	{ campo: 'Cambio', valor: cambioTexto(data.transmission) ?? GUION },
	{ campo: 'Combustible', valor: data.fuel ?? GUION },
	{ campo: 'Color', valor: data.color ?? GUION },
];

const fila = (campo: string, valor: unknown) => ({ campo, valor: String(valor ?? '') });

const conValor = (filas: { campo: string; valor: string }[]) =>
	filas.filter((fila) => fila.valor !== '' && fila.valor !== 'undefined');

// Ficha y estado se construyen desde los campos del .txt. Solo se pinta lo que
// tiene valor, así un coche sin cilindrada no deja una fila vacía.
const bloques = [
	{
		titulo: 'Ficha técnica',
		filas: conValor([
			fila('Marca', data.make),
			fila('Modelo', data.model),
			fila('Versión', data.variant),
			fila('Tipo de vehículo', data.body_type),
			fila('Kilometraje', kmTexto(data.mileage_km)),
			fila('Fecha', data.first_registration),
			fila('Potencia', potenciaTexto(data)),
			fila('Cilindrada', data.displacement_cc && `${data.displacement_cc} cm³`),
			fila('Combustible', data.fuel),
			fila('Etiqueta medioambiental', data.environmental_label),
			fila('Cambio', cambioTexto(data.transmission)),
			fila('Tracción', data.drivetrain),
			fila('Puertas', data.doors),
			fila('Plazas', data.seats),
			fila('Color exterior', data.color),
			fila('Tipo de pintura', data.paint),
			fila('Consumo', data.consumption),
		]),
	},
	{
		titulo: 'Estado e historial',
		filas: conValor([
			fila('Ha tenido accidentes', data.accidents),
			fila('Libro de mantenimiento completo', data.service_book),
			fila('ITV nueva', data.itv),
			fila('Fumador', data.smoker),
			fila('Vehículo de alquiler', data.rental),
			fila('Garantía', data.warranty),
		]),
	},
].filter((seccion) => seccion.filas.length > 0);

// El cuerpo del .txt es el comentario, tal cual lo escribió el vendedor.
const comentarios = (coche.body ?? '')
	.split(/\n{2,}/)
	.map((parrafo) => parrafo.trim())
	.filter(Boolean);

const mensajeWhatsapp = encodeURIComponent(
	`Hola, me interesa el ${nombreCompleto(data)} (ref. ${data.reference}).`,
);

// Descripción propia por coche: si todas las fichas compartieran la del sitio,
// Google las vería como veinte copias de la misma página. Se queda por debajo
// de los 160 caracteres que muestra el buscador.
const descripcion = [
	nombreCompleto(data),
	data.first_registration,
	data.mileage_km != null && kmTexto(data.mileage_km),
	potenciaTexto(data),
	cambioTexto(data.transmission),
	vendido
		? 'Vendido'
		: contado != null
			? `${precioTexto(contado)} en Autoclub Trackdays, Madrid`
			: 'En Autoclub Trackdays, Madrid',
]
	.filter(Boolean)
	.join(' · ');

// --- Datos estructurados ----------------------------------------------------
//
// El tipo `Car` es a la vez `Vehicle` y `Product`, que es lo que permite que
// Google enseñe el precio y la foto en el resultado en vez de una línea de
// texto. Todo sale de los campos que ya tiene el .txt: lo que el coche no
// declare, simplemente no se emite.

const urlCoche = new URL(`${rutaCoche(data)}/`, Astro.site).href;

/** Solo pone la clave si hay valor: schema.org prefiere que falte una propiedad
 *  a que llegue vacía o a cero. */
const si = (valor: unknown, contenido: object) => (valor ? contenido : {});

const esquemaCoche = {
	'@context': 'https://schema.org',
	'@type': 'Car',
	'@id': `${urlCoche}#coche`,
	name: nombreCompleto(data),
	description: descripcion,
	url: urlCoche,
	image: galeria,
	brand: { '@type': 'Brand', name: data.make },
	itemCondition: 'https://schema.org/UsedCondition',
	sku: String(data.reference ?? ''),

	...si(data.model, { model: data.model }),
	...si(data.variant, { vehicleConfiguration: data.variant }),
	...si(data.body_type, { bodyType: data.body_type }),
	...si(data.color, { color: data.color }),
	...si(data.doors, { numberOfDoors: data.doors }),
	...si(data.seats, { seatingCapacity: data.seats }),
	...si(data.drivetrain, { driveWheelConfiguration: data.drivetrain }),
	...si(data.fuel, { fuelType: data.fuel }),
	...si(data.transmission, { vehicleTransmission: cambioTexto(data.transmission) }),

	// De la fecha solo se declara el año: el .txt guarda MM/AAAA y
	// `vehicleModelDate` espera una fecha, no un mes suelto.
	//
	// Aquí no se puede usar `si()`: sus argumentos se evalúan antes de que decida,
	// así que el `.split` reventaba en los coches que no traen fecha.
	...(data.first_registration ? { vehicleModelDate: data.first_registration.split('/')[1] } : {}),

	...si(data.mileage_km, {
		mileageFromOdometer: {
			'@type': 'QuantitativeValue',
			value: data.mileage_km,
			unitCode: 'KMT',
		},
	}),

	// En kW y cm³ porque son las unidades que entiende el vocabulario; los CV
	// se siguen viendo en la ficha de la página.
	...si(data.power_kw || data.displacement_cc, {
		vehicleEngine: {
			'@type': 'EngineSpecification',
			...si(data.power_kw, {
				enginePower: { '@type': 'QuantitativeValue', value: data.power_kw, unitCode: 'KWT' },
			}),
			...si(data.displacement_cc, {
				engineDisplacement: {
					'@type': 'QuantitativeValue',
					value: data.displacement_cc,
					unitCode: 'CMQ',
				},
			}),
		},
	}),

	// Sin precio no hay oferta que declarar: un `Offer` sin `price` es inválido y
	// Google puede desactivar los resultados enriquecidos de todo el sitio.
	...si(contado != null, {
		offers: {
		'@type': 'Offer',
		url: urlCoche,
		price: contado,
		priceCurrency: 'EUR',
		itemCondition: 'https://schema.org/UsedCondition',
		availability: vendido ? 'https://schema.org/SoldOut' : 'https://schema.org/InStock',
		// Apunta a la ficha del negocio de la portada en vez de repetirla.
		seller: { '@id': new URL('#negocio', Astro.site).href },
		},
	}),
};

/** La ruta que Google enseña bajo el título, en lugar de la URL cruda. */
const esquemaMigas = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Inicio', item: Astro.site?.href },
		{ '@type': 'ListItem', position: 2, name: 'Catálogo', item: new URL('/catalogo/', Astro.site).href },
		{ '@type': 'ListItem', position: 3, name: nombreCompleto(data) },
	],
};
---

<Layout
	title={`${nombreCompleto(data)} – Autoclub Trackdays`}
	description={descripcion}
	image={galeria[0]}
	noindex={vendido}
>
	<Fragment slot="cabeza">
		<script type="application/ld+json" set:html={JSON.stringify(esquemaCoche)} is:inline />
		<script type="application/ld+json" set:html={JSON.stringify(esquemaMigas)} is:inline />
	</Fragment>

	<section class="mx-auto max-w-6xl px-6 py-10">
		<nav aria-label="Migas" class="flex items-center gap-3 text-base text-gray-500">
			<a
				href="/catalogo"
				aria-label="Volver al catálogo"
				class="group flex items-center gap-3 transition hover:text-black"
			>
				<svg
					viewBox="0 0 20 20"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="h-5 w-5 transition-transform group-hover:-translate-x-1"
					aria-hidden="true"
				>
					<path d="M16 10H4m0 0 4-4m-4 4 4 4"></path>
				</svg>
				Catálogo
			</a>
			<span>/</span>
			<span class="text-gray-900">{nombre}</span>
		</nav>

		<!-- En el móvil va todo en una columna y en este orden: fotos, nombre y
		     precio, y por último la ficha. En pantalla grande la ficha vuelve
		     debajo de las fotos y el bloque de precio se va a la derecha, donde
		     acompaña al scroll.

		     El `min-w-0` no es adorno: sin él la columna se estira hasta el ancho
		     de la tira de miniaturas —2.900 px con 27 fotos— y la foto principal,
		     que es `w-full`, se estira con ella. -->
		<div class="mt-8 grid gap-10 lg:grid-cols-5 lg:items-start">
			<div class="min-w-0 lg:col-span-3 lg:col-start-1 lg:row-start-1">
				<div class="relative overflow-hidden rounded-sm border border-gray-200 bg-gray-100">
					<button
						type="button"
						data-abrir-galeria
						aria-label="Ver las fotos en grande"
						class="block w-full cursor-zoom-in"
					>
						<img
							data-foto-principal
							src={galeria[0]}
							alt={nombreCompleto(data)}
							width="1200"
							height="900"
							class="aspect-4/3 w-full object-cover"
						/>
					</button>

					{
						vendido && (
							<span class="absolute top-4 left-4 bg-black px-4 py-2 text-sm font-semibold tracking-wide text-white uppercase">
								Vendido
							</span>
						)
					}

					<span
						data-contador
						class="absolute right-4 bottom-4 rounded-sm bg-black/70 px-3 py-1 text-sm font-medium text-white"
					>
						1 / {galeria.length}
					</span>

					{
						galeria.length > 1 && (
							<>
								<button
									type="button"
									data-navegar="anterior"
									aria-label="Foto anterior"
									class="absolute top-1/2 left-4 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-full border border-gray-200 bg-white text-black shadow-lg transition hover:scale-110 hover:border-(--accent) hover:bg-(--accent)"
								>
									<svg
										viewBox="0 0 20 20"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										class="h-4 w-4"
										aria-hidden="true"
									>
										<path d="M12 4 6 10l6 6" />
									</svg>
								</button>

								<button
									type="button"
									data-navegar="siguiente"
									aria-label="Foto siguiente"
									class="absolute top-1/2 right-4 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-full border border-gray-200 bg-white text-black shadow-lg transition hover:scale-110 hover:border-(--accent) hover:bg-(--accent)"
								>
									<svg
										viewBox="0 0 20 20"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										class="h-4 w-4"
										aria-hidden="true"
									>
										<path d="m8 4 6 6-6 6" />
									</svg>
								</button>
							</>
						)
					}
				</div>

				{
					galeria.length > 1 && (
						<ul
							data-miniaturas
							class="mt-3 flex gap-3 overflow-x-auto pb-1 [-ms-overflow-style:none] scrollbar-none [&::-webkit-scrollbar]:hidden"
						>
							{galeria.map((foto, indice) => (
								<li>
									<button
										type="button"
										data-foto={foto}
										data-indice={indice}
										aria-label={`Foto ${indice + 1}`}
										aria-current={indice === 0}
										class="block w-24 shrink-0 overflow-hidden rounded-sm border-2 border-transparent transition hover:border-gray-400 aria-current:border-(--accent)"
									>
										<img
											src={foto}
											alt=""
											loading="lazy"
											width="192"
											height="144"
											class="aspect-4/3 w-full object-cover"
										/>
									</button>
								</li>
							))}
						</ul>
					)
				}

				<dialog
					data-galeria
					class="m-0 h-full max-h-none w-full max-w-none bg-transparent p-0 backdrop:bg-black/90"
				>
					{/* El clic sobre este contenedor, es decir fuera de la foto, cierra. */}
					<div data-fondo class="flex h-full w-full flex-col">
						<div class="flex justify-end p-4">
							<button
								type="button"
								data-cerrar-galeria
								aria-label="Cerrar"
								class="grid h-12 w-12 place-items-center rounded-full border border-white/30 text-white transition hover:border-(--accent) hover:bg-(--accent) hover:text-black"
							>
								<svg
									viewBox="0 0 20 20"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									class="h-5 w-5"
									aria-hidden="true"
								>
									<path d="m5 5 10 10M15 5 5 15" />
								</svg>
							</button>
						</div>

						<div data-fondo class="relative flex min-h-0 flex-1 items-center justify-center px-4">
							<img
								data-foto-principal
								src={galeria[0]}
								alt={nombreCompleto(data)}
								class="max-h-full max-w-full object-contain"
							/>

							{
								galeria.length > 1 && (
									<>
										<button
											type="button"
											data-navegar="anterior"
											aria-label="Foto anterior"
											class="absolute top-1/2 left-4 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-full border border-gray-200 bg-white text-black shadow-lg transition hover:scale-110 hover:border-(--accent) hover:bg-(--accent)"
										>
											<svg
												viewBox="0 0 20 20"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
												stroke-linecap="round"
												stroke-linejoin="round"
												class="h-4 w-4"
												aria-hidden="true"
											>
												<path d="M12 4 6 10l6 6" />
											</svg>
										</button>

										<button
											type="button"
											data-navegar="siguiente"
											aria-label="Foto siguiente"
											class="absolute top-1/2 right-4 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-full border border-gray-200 bg-white text-black shadow-lg transition hover:scale-110 hover:border-(--accent) hover:bg-(--accent)"
										>
											<svg
												viewBox="0 0 20 20"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
												stroke-linecap="round"
												stroke-linejoin="round"
												class="h-4 w-4"
												aria-hidden="true"
											>
												<path d="m8 4 6 6-6 6" />
											</svg>
										</button>
									</>
								)
							}
						</div>

						<div data-fondo class="flex items-center justify-between gap-4 p-4">
							<span data-contador class="text-sm font-medium text-white">
								1 / {galeria.length}
							</span>
						</div>

					<!-- El scroll vive en el contenedor y la lista se centra con mx-auto:
					     con justify-center, al desbordar quedarían fotos inalcanzables
					     por la izquierda. -->
					<div
						class="overflow-x-auto pb-6 [-ms-overflow-style:none] scrollbar-none [&::-webkit-scrollbar]:hidden"
					>
						<ul class="mx-auto flex w-max gap-3 px-4">
							{galeria.map((foto, indice) => (
								<li>
									<button
										type="button"
										data-foto={foto}
										data-indice={indice}
										aria-label={`Foto ${indice + 1}`}
										aria-current={indice === 0}
										class="block w-20 shrink-0 overflow-hidden rounded-sm border-2 border-transparent opacity-60 transition hover:opacity-100 aria-current:border-(--accent) aria-current:opacity-100"
									>
										<img
											src={foto}
											alt=""
											loading="lazy"
											width="160"
											height="120"
											class="aspect-4/3 w-full object-cover"
										/>
									</button>
								</li>
							))}
							</ul>
						</div>
					</div>
				</dialog>
			</div>

			<div
				class="min-w-0 lg:col-span-2 lg:col-start-4 lg:row-span-2 lg:row-start-1 lg:sticky lg:top-24"
			>
				<div>
					<h1 class="text-4xl font-semibold tracking-tight text-gray-900">{nombre}</h1>
					{data.variant && <p class="mt-1 text-xl text-gray-600">{data.variant}</p>}

					<div class="mt-6 flex flex-wrap items-end justify-between gap-x-4 gap-y-3 border-t border-gray-200 pt-6 sm:gap-x-8">
						<div>
							<p class="text-sm tracking-wide text-gray-500 uppercase sm:text-base">Al contado</p>
							<p class="text-3xl font-bold text-gray-900 sm:text-5xl">{precioTexto(contado)}</p>
						</div>

						{
							financiado && (
								<div class="text-right">
									<p class="text-sm tracking-wide text-gray-500 uppercase sm:text-base">Financiado</p>
									<p class="text-2xl font-semibold text-emerald-800 sm:text-4xl">
										{precioTexto(financiado)}
									</p>
								</div>
							)
						}
					</div>

					<dl class="mt-6 grid grid-cols-2 gap-x-4 gap-y-3 border-t border-gray-200 pt-6 text-sm sm:gap-x-6 sm:gap-y-4 sm:text-base">
						{
							resumen.map((dato) => (
								<div class="flex justify-between gap-2">
									<dt class="text-gray-500">{dato.campo}</dt>
									<dd class="text-right font-medium text-gray-900">{dato.valor}</dd>
								</div>
							))
						}
					</dl>

					{
						vendido ? (
							<div class="mt-8 border-t border-gray-200 pt-6">
								<p class="text-gray-600">
									Este coche ya está vendido, pero solemos tener unidades parecidas.
								</p>
								<a
									href="/catalogo"
									class="mt-4 inline-flex items-center gap-2 border-b-2 border-(--accent) pb-1 text-sm font-semibold tracking-wide text-black uppercase transition hover:translate-x-3"
								>
									Ver coches disponibles
								</a>
							</div>
						) : (
							<div class="mt-8 flex flex-wrap gap-3 border-t border-gray-200 pt-6">
								<a
									href={`tel:${CONTACTO.telefono.tel}`}
									class="rounded-sm bg-(--accent) px-8 py-4 text-lg font-semibold text-black transition hover:-translate-y-1 hover:bg-(--accent-strong)"
								>
									Llamar {CONTACTO.telefono.texto}
								</a>
								<a
									href={`https://wa.me/${CONTACTO.whatsapp.numero}?text=${mensajeWhatsapp}`}
									target="_blank"
									rel="noopener"
									class="rounded-sm border border-gray-300 px-8 py-4 text-lg font-semibold text-gray-900 transition hover:-translate-y-1 hover:border-gray-900"
								>
									WhatsApp
								</a>
							</div>
						)
					}

				</div>
			</div>

			<div class="min-w-0 flex flex-col gap-12 border-t border-gray-200 pt-12 lg:col-span-3 lg:col-start-1 lg:row-start-2">
					{
						bloques.map((seccion) => (
							<section>
								<h2 class="text-lg font-semibold tracking-wide text-gray-900 uppercase">
									{seccion.titulo}
								</h2>
								<span class="mt-2 block h-0.5 w-12 bg-(--accent)" />

								{seccion.filas.length > 0 && (
									<dl class="mt-5 grid gap-x-12 sm:grid-cols-2">
										{seccion.filas.map((fila) => (
											<div class="flex justify-between gap-4 border-b border-gray-100 py-2 text-base">
												<dt class="text-gray-500">{fila.campo}</dt>
												<dd class="text-right font-medium text-gray-900">{fila.valor}</dd>
											</div>
										))}
									</dl>
								)}

							</section>
						))
					}

					{
						comentarios.length > 0 && (
							<section>
								<h2 class="text-lg font-semibold tracking-wide text-gray-900 uppercase">
									Comentarios
								</h2>
								<span class="mt-2 block h-0.5 w-12 bg-(--accent)" />

								<div class="mt-5 flex flex-col gap-3 text-base leading-relaxed text-gray-600">
									{comentarios.map((parrafo) => (
										<p>{parrafo}</p>
									))}
								</div>
							</section>
						)
					}
				</div>
		</div>

	</section>
</Layout>

<script>
	// La galería se pinta dos veces: en la página y dentro del panel a pantalla
	// completa. Un solo índice manda sobre las dos, así que al cerrar el panel la
	// foto de la página es la última que se estaba mirando.
	const principales = [...document.querySelectorAll<HTMLImageElement>('[data-foto-principal]')];
	const contadores = [...document.querySelectorAll<HTMLElement>('[data-contador]')];
	const miniaturas = [...document.querySelectorAll<HTMLButtonElement>('[data-foto]')];
	const panel = document.querySelector<HTMLDialogElement>('[data-galeria]');

	const total = new Set(miniaturas.map((boton) => boton.dataset.indice)).size;

	if (principales.length > 0 && total > 0) {
		let actual = 0;

		const mostrar = (indice: number) => {
			actual = (indice + total) % total;

			const elegida = miniaturas.find((boton) => Number(boton.dataset.indice) === actual);
			if (!elegida) return;

			principales.forEach((img) => (img.src = elegida.dataset.foto!));
			contadores.forEach((c) => (c.textContent = `${actual + 1} / ${total}`));

			miniaturas.forEach((boton) => {
				const activa = Number(boton.dataset.indice) === actual;
				boton.setAttribute('aria-current', String(activa));
				if (activa) boton.scrollIntoView({ block: 'nearest', inline: 'nearest' });
			});
		};

		miniaturas.forEach((boton) =>
			boton.addEventListener('click', () => mostrar(Number(boton.dataset.indice))),
		);

		document.querySelectorAll<HTMLButtonElement>('[data-navegar]').forEach((boton) => {
			boton.addEventListener('click', () =>
				mostrar(actual + (boton.dataset.navegar === 'siguiente' ? 1 : -1)),
			);
		});

		document.addEventListener('keydown', (evento) => {
			if (evento.key === 'ArrowRight') mostrar(actual + 1);
			if (evento.key === 'ArrowLeft') mostrar(actual - 1);
		});

		if (panel) {
			const abrir = () => {
				panel.showModal();
				// Sin esto la página de detrás sigue desplazándose con la rueda.
				document.body.classList.add('overflow-hidden');
				mostrar(actual);
			};

			const cerrar = () => {
				panel.close();
				document.body.classList.remove('overflow-hidden');
			};

			document
				.querySelectorAll('[data-abrir-galeria]')
				.forEach((boton) => boton.addEventListener('click', abrir));

			document
				.querySelectorAll('[data-cerrar-galeria]')
				.forEach((boton) => boton.addEventListener('click', cerrar));

			// Cierra al pulsar fuera de la foto: el fondo, el propio <dialog> o los
			// huecos vacíos alrededor. Sobre la imagen o los botones no cierra.
			panel.addEventListener('click', (evento) => {
				const destino = evento.target as HTMLElement;
				if (destino === panel || destino.hasAttribute('data-fondo')) cerrar();
			});

			// Escape lo cierra por su cuenta, pero hay que soltar el scroll igual.
			panel.addEventListener('close', () => document.body.classList.remove('overflow-hidden'));
		}
	}
</script>
